{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  // Kun TypeScript-filer i src-mappen (og undermapper) skal kompileres
  "include": ["src/**/*.ts"],
  // Prisma's config-fil skal IKKE med i buildet
  "exclude": ["prisma.config.ts"]
}