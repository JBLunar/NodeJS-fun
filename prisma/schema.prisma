// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Genererer Prisma Client
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Vælger SQLite som database
datasource db {
  provider = "sqlite"
}

// Model til brugere
model User {
  id        Int      @id @default(autoincrement()) // unikt nummer, tæller automatisk op
  firstname String                                 // fornavn
  lastname  String                                 // efternavn
  phone     Int                                    // telefonnummer
  email     String   @unique                       // email – må ikke findes to gange
  password  String                                 // adgangskode
  height    Float    @default(0.00)                // højde – 0.00 hvis ikke udfyldt
  isActive  Boolean  @default(false)               // er brugeren aktiv? starter som nej
  createdAt DateTime @default(now())               // oprettelsestidspunkt – sættes automatisk

  // Tabellen skal hedde users i databasen
  @@map("users")
}


// Model til bilmærker
model Brand {
  id      Int    @id @default(autoincrement()) // primary key – unikt nummer
  name    String                               // navn, f.eks. "Volvo"
  logoUrl String                               // filnavn på logoet

  // Et brand kan have mange biler (relationsfelt – findes kun i Prisma)
  cars    Car[]

  // Tabellen skal hedde brands i databasen
  @@map("brands")
}

// Model til biler
model Car {
  id      Int    @id @default(autoincrement()) // primary key – unikt nummer
  model   String                               // bilmodel, f.eks. "XC40"
  brandId Int                                  // foreign key – peger på brands.id

  // Forbinder bilen med ét brand (relationsfelt – findes kun i Prisma)
  brand   Brand  @relation(fields: [brandId], references: [id])

  // Tabellen skal hedde cars i databasen
  @@map("cars")
}